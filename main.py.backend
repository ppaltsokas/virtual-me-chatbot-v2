        openai_client = OpenAI(api_key=openai_api_key)
        logger.info("OpenAI client initialized for embeddings")
    else:
        logger.warning("OPENAI_API_KEY not set. FAISS vector search will be disabled.")

def embed_texts(texts: List[str]) -> List[List[float]]:
    """Generate embeddings for a list of texts, batching to avoid token limits.
    
    Uses token-based batching to ensure we stay under the 300k token limit per request.
    """
    if not openai_client:
        raise RuntimeError("OpenAI client not initialized. Set OPENAI_API_KEY environment variable.")
    
    if not texts:
        return []
    
    # OpenAI limits: max 2048 inputs per request, and ~300k tokens per request
    # Estimate tokens: ~4 characters per token (conservative estimate)
    # Target: stay well under 200k tokens per batch for safety
    MAX_TOKENS_PER_BATCH = 200000  # Conservative limit (well under 300k)
    CHARS_PER_TOKEN = 4  # Conservative estimate
    
    all_embeddings = []
    current_batch = []
    current_batch_tokens = 0
    batch_num = 0
    
    logger.info(f"Embedding {len(texts)} texts using token-based batching (max {MAX_TOKENS_PER_BATCH} tokens/batch)...")
    
    for text in texts:
        # Count tokens accurately using tiktoken
        text_tokens = count_tokens(text)
        
        # If adding this text would exceed the limit, process current batch first
        if current_batch and (current_batch_tokens + text_tokens > MAX_TOKENS_PER_BATCH):
            batch_num += 1
            try:
                logger.info(f"Processing batch {batch_num} ({len(current_batch)} texts, ~{current_batch_tokens} tokens)...")
                resp = openai_client.embeddings.create(
                    model=EMBEDDINGS_MODEL, 
                    input=current_batch, 
                    timeout=120.0
                )
                batch_embeddings = [d.embedding for d in resp.data]
                all_embeddings.extend(batch_embeddings)
                logger.info(f"Batch {batch_num} completed ({len(batch_embeddings)} embeddings)")
            except Exception as e:
                logger.error(f"Embedding failed for batch {batch_num}: {e}")
                raise
            
            # Reset for next batch
            current_batch = []
            current_batch_tokens = 0
        
        # Hard per-input safety check (token-accurate)
        # This should rarely trigger since we token-split during build_faiss_index,
        # but it's a critical safety net
        actual_tokens = count_tokens(text)
        if actual_tokens > EMBED_MAX_TOKENS:
            logger.warning(f"Text still exceeds EMBED_MAX_TOKENS ({actual_tokens} tokens) after preprocessing; splitting again.")
            # Split using token-accurate method
            split_chunks = split_text_by_tokens(text, max_tokens=EMBED_TARGET_TOKENS)
            if split_chunks:
                logger.info(f"Splitting oversized text into {len(split_chunks)} token-safe chunks")
                split_embeddings = embed_texts(split_chunks)
                all_embeddings.extend(split_embeddings)
            continue
        
        # Add text to current batch (now guaranteed to be token-safe)
        current_batch.append(text)
        current_batch_tokens += actual_tokens  # Use actual token count, not estimate
    
    # Process remaining batch
    if current_batch:
        batch_num += 1
        try:
            logger.info(f"Processing final batch {batch_num} ({len(current_batch)} texts, ~{current_batch_tokens} tokens)...")
            resp = openai_client.embeddings.create(
                model=EMBEDDINGS_MODEL, 
                input=current_batch, 
                timeout=120.0
            )
            batch_embeddings = [d.embedding for d in resp.data]
            all_embeddings.extend(batch_embeddings)
            logger.info(f"Final batch {batch_num} completed ({len(batch_embeddings)} embeddings)")
        except Exception as e:
            logger.error(f"Embedding failed for final batch {batch_num}: {e}")
            raise
    
    logger.info(f"Successfully embedded all {len(all_embeddings)} texts in {batch_num} batches")
    return all_embeddings

def _split_md(text: str, max_chars: int = 30000) -> List[str]:
    """Split markdown text into chunks.
    
    Respects OpenAI embedding model limit: max 8192 tokens per input (~32k chars).
    Uses max_chars=30000 to stay well under the limit.
    """
    # OpenAI embedding models have max 8192 tokens per input
    # With ~4 chars per token, that's ~32k chars max
    # Use 30k to be safe
    MAX_CHARS_PER_CHUNK = 30000
    
    parts, buf, count = [], [], 0
    for line in text.splitlines(keepends=True):
        line_len = len(line)
        
        # If a single line is too long, split it
        if line_len > MAX_CHARS_PER_CHUNK:
            # Save current buffer if any
            if buf:
                parts.append("".join(buf).strip())
                buf, count = [], 0
            
            # Split the long line into smaller chunks
            for i in range(0, line_len, MAX_CHARS_PER_CHUNK):
                chunk = line[i:i + MAX_CHARS_PER_CHUNK]
                if chunk.strip():
                    parts.append(chunk.strip())
            continue
        
        # If adding this line would exceed limit, save current buffer
        if count + line_len > MAX_CHARS_PER_CHUNK and buf:
            parts.append("".join(buf).strip())
            buf, count = [], 0
        
        buf.append(line)
        count += line_len
        
        # Split at headers to keep semantic coherence
        if line.strip().startswith(("#", "##", "###")) and buf and count > 1000:
            parts.append("".join(buf).strip())
            buf, count = [], 0
    
    if buf:
        parts.append("".join(buf).strip())
    
    # Final safety check: ensure no chunk exceeds limit
    final_parts = []
    for part in parts:
        if len(part) > MAX_CHARS_PER_CHUNK:
            # Split oversized chunks
            for i in range(0, len(part), MAX_CHARS_PER_CHUNK):
                chunk = part[i:i + MAX_CHARS_PER_CHUNK]
                if chunk.strip():
                    final_parts.append(chunk.strip())
        else:
            final_parts.append(part)
    
    return [p for p in final_parts if p]

def read_ipynb_text(path: Path) -> str:
    """Read Jupyter notebook and preserve markdown comments and code structure."""
    if not NBFORMAT_AVAILABLE:
        logger.warning(f"nbformat not installed; skipping .ipynb: {path}")
        return ""
    try:
        nb = nbformat.read(str(path), as_version=4)
        parts = []
        for i, cell in enumerate(nb.cells):
            if cell.cell_type == "markdown":
                parts.append(f"=== MARKDOWN CELL {i+1} (INSIGHTS/EXPLANATIONS) ===\n{cell.source}\n")
            elif cell.cell_type == "code":
                code_text = cell.source
                if hasattr(cell, 'outputs') and cell.outputs:
                    code_text += "\n# [Code execution results present in original notebook]"
                parts.append(f"=== CODE CELL {i+1} ===\n```code\n{code_text}\n```\n")
        return "\n\n".join(parts)
    except Exception as e:
        logger.error(f"Error reading notebook {path}: {e}")
        return ""

def build_faiss_index() -> int:
    """Build FAISS index from knowledge base files."""
    if not FAISS_AVAILABLE or not openai_client:
        logger.warning("FAISS or OpenAI not available. Skipping index build.")
        return 0
    
    texts, meta = [], []
    pdf_count, other_count = 0, 0
    
    logger.info("[FAISS] Starting to index files from kb/ directory...")
    supported_extensions = ['*.pdf', '*.txt', '*.md', '*.ipynb']
    files = []
    for ext in supported_extensions:
        files.extend(list(KB_FOLDER.rglob(ext)))
    
    logger.info(f"[FAISS] Found {len(files)} files to index")
    
    for fp in files:
        logger.info(f"[FAISS] Processing: {fp}")
        if fp.suffix.lower() == '.ipynb':
            raw = read_ipynb_text(fp)
        else:
            raw = extract_text_from_file(fp)
        
        if not raw.strip():
            logger.warning(f"[FAISS] Warning: {fp} has no extractable text")
            continue
        
        if fp.suffix.lower() == '.pdf':
            pdf_count += 1
        else:
            other_count += 1
        
        chunks = _split_md(raw)
        # Hard guarantee: never exceed embedding model limit using token-accurate splitting
        safe_chunks = []
        for ch in chunks:
            # Split each chunk to ensure it's token-safe
            safe_chunks.extend(split_text_by_tokens(ch, max_tokens=EMBED_TARGET_TOKENS))
        
        logger.info(f"[FAISS] Split {fp} into {len(chunks)} chunks -> {len(safe_chunks)} token-safe chunks")
        
        for ch in safe_chunks:
            texts.append(ch)
            rel_path = fp.relative_to(KB_FOLDER)
            meta.append({"source": str(rel_path).replace('\\', '/')})
    
    if not texts:
        logger.warning("[FAISS] No indexable text found.")
        return 0
    
    logger.info(f"[FAISS] Indexing {len(texts)} chunks ({pdf_count} PDFs, {other_count} other files)...")
    vecs = embed_texts(texts)
    mat = np.array(vecs, dtype="float32")
    faiss.normalize_L2(mat)
    index = faiss.IndexFlatIP(mat.shape[1])
    index.add(mat)
    
    faiss.write_index(index, str(FAISS_INDEX))
    with open(FAISS_STORE, "w", encoding="utf-8") as f:
        for t, m in zip(texts, meta):
            f.write(json.dumps({"chunk": t, **m}, ensure_ascii=False) + "\n")
    
    logger.info(f"[FAISS] Successfully indexed {len(texts)} chunks.")
    return len(texts)

def _load_faiss_index():
    """Load FAISS index and metadata."""
    if not FAISS_AVAILABLE or not (FAISS_INDEX.exists() and FAISS_STORE.exists()):
        return None, []
    index = faiss.read_index(str(FAISS_INDEX))
    with open(FAISS_STORE, "r", encoding="utf-8") as f:
        meta = [json.loads(line) for line in f]
    return index, meta

def rag_search(query: str, k: int = 4) -> str:
    """Semantic search using FAISS."""
    if not FAISS_AVAILABLE or not openai_client:
        return "(Vector search not available - using keyword search)"
    
    index, meta = _load_faiss_index()
    if not index or not meta:
        return "(KB empty or not indexed)"
    
    try:
        qv = np.array(embed_texts([query])[0], dtype="float32").reshape(1, -1)
        faiss.normalize_L2(qv)
        scores, idxs = index.search(qv, k)
        out = []
        for s, i in zip(scores[0], idxs[0]):
            if i == -1:
                continue
            source = meta[i]["source"]
            chunk = meta[i]["chunk"]
            if any(keyword in source.lower() for keyword in [".pdf", "hw", "assignment"]):
                out.insert(0, f"[{source}] {chunk}")
            else:
                out.append(f"[{source}] {chunk}")
        return "\n\n".join(out) if out else "(no matches)"
    except Exception as e:
        logger.error(f"FAISS search error: {e}")
        return "(search error)"

def extract_images_from_pdf(pdf_path: Path, pdf_key: str) -> List[str]:
    """Extract images from a PDF file and save them to the images folder."""
    extracted_images = []
    try:
        with open(pdf_path, 'rb') as file:
            pdf_reader = PyPDF2.PdfReader(file)
            image_count = 0
            max_images_per_pdf = 50  # Limit to prevent hangs on PDFs with many images
            max_pages = 100  # Limit pages to process
            
            for page_num, page in enumerate(pdf_reader.pages[:max_pages]):
                try:
                    if '/Resources' in page and '/XObject' in page['/Resources']:
                        xObject = page['/Resources']['/XObject'].get_object()
                        
                        if not isinstance(xObject, dict):
                            continue
                            
                        for obj_name in xObject:
                            obj = xObject[obj_name]
                            if '/Subtype' in obj and obj['/Subtype'] == '/Image':
                                try:
                                    # Get image dimensions
                                    width = obj['/Width']
                                    height = obj['/Height']
                                    
                                    # Get image data
                                    if '/Filter' in obj:
                                        filter_type = obj['/Filter']
                                        if isinstance(filter_type, list):
                                            filter_type = filter_type[0]
                                        
                                        # Handle different compression types
                                        if filter_type == '/DCTDecode':  # JPEG
                                            data = obj.get_data()
                                            # Create image filename
                                            pdf_name = pdf_path.stem
                                            image_filename = f"{pdf_name}_page{page_num+1}_img{image_count}.jpg"
                                            image_path = IMAGES_FOLDER / image_filename
                                            
                                            # Save JPEG directly
                                            with open(image_path, 'wb') as img_file:
                                                img_file.write(data)
                                            
                                            extracted_images.append(image_filename)
                                            image_count += 1
                                            logger.info(f"Extracted JPEG image: {image_filename} from {pdf_path.name} page {page_num+1}")
                                            
                                            # Limit total images to prevent hangs
                                            if image_count >= max_images_per_pdf:
                                                logger.info(f"Reached image limit ({max_images_per_pdf}) for {pdf_path.name}, stopping extraction")
                                                return extracted_images
                                        else:
                                            # Try to extract as raw image
                                            try:
                                                data = obj.get_data()
                                                
                                                # Determine color mode
                                                if '/ColorSpace' in obj:
                                                    colorspace = obj['/ColorSpace']
                                                    if isinstance(colorspace, list):
                                                        colorspace = colorspace[0]
                                                    
                                                    if colorspace == '/DeviceRGB':
                                                        mode = "RGB"
                                                    elif colorspace == '/DeviceGray':
                                                        mode = "L"
                                                    elif colorspace == '/DeviceCMYK':
                                                        mode = "CMYK"
                                                    else:
                                                        mode = "RGB"
                                                else:
                                                    mode = "RGB"
                                                
                                                # Create image filename
                                                pdf_name = pdf_path.stem
                                                image_filename = f"{pdf_name}_page{page_num+1}_img{image_count}.png"
                                                image_path = IMAGES_FOLDER / image_filename
                                                
                                                # Convert and save image
                                                img = Image.frombytes(mode, (width, height), data)
                                                if mode == "CMYK":
                                                    img = img.convert("RGB")
                                                img.save(image_path, "PNG")
                                                
                                                extracted_images.append(image_filename)
                                                image_count += 1
                                                logger.info(f"Extracted image: {image_filename} from {pdf_path.name} page {page_num+1}")
                                                
                                                # Limit total images to prevent hangs
                                                if image_count >= max_images_per_pdf:
                                                    logger.info(f"Reached image limit ({max_images_per_pdf}) for {pdf_path.name}, stopping extraction")
                                                    return extracted_images
                                            except Exception as e:
                                                logger.warning(f"Error extracting raw image from {pdf_path.name} page {page_num+1}: {e}")
                                                continue
                                    else:
                                        # No filter, try raw extraction
                                        try:
                                            data = obj.get_data()
                                            mode = "RGB"
                                            
                                            pdf_name = pdf_path.stem
                                            image_filename = f"{pdf_name}_page{page_num+1}_img{image_count}.png"
                                            image_path = IMAGES_FOLDER / image_filename
                                            
                                            img = Image.frombytes(mode, (width, height), data)
                                            img.save(image_path, "PNG")
                                            
                                            extracted_images.append(image_filename)
                                            image_count += 1
                                            logger.info(f"Extracted raw image: {image_filename} from {pdf_path.name} page {page_num+1}")
                                            
                                            # Limit total images to prevent hangs
                                            if image_count >= max_images_per_pdf:
                                                logger.info(f"Reached image limit ({max_images_per_pdf}) for {pdf_path.name}, stopping extraction")
                                                return extracted_images
                                        except Exception as e:
                                            logger.warning(f"Error extracting raw image from {pdf_path.name} page {page_num+1}: {e}")
                                            continue
                                except Exception as e:
                                    logger.warning(f"Error processing image object from {pdf_path.name} page {page_num+1}: {e}")
                                    continue
                except Exception as e:
                    logger.warning(f"Error processing page {page_num+1} of {pdf_path.name}: {e}")
                    continue
    except Exception as e:
        logger.error(f"Error extracting images from PDF {pdf_path}: {e}")
    
    return extracted_images

def extract_text_from_pdf(pdf_path: Path) -> str:
    """Extract text content from a PDF file."""
    try:
        with open(pdf_path, 'rb') as file:
            pdf_reader = PyPDF2.PdfReader(file)
            text = ""
            for page in pdf_reader.pages:
                text += page.extract_text() + "\n"
            return text
    except Exception as e:
        logger.error(f"Error reading PDF {pdf_path}: {e}")
        return ""

def extract_text_from_file(file_path: Path) -> str:
    """Extract text content from various file types."""
    try:
        suffix = file_path.suffix.lower()
        if suffix == '.pdf':
            return extract_text_from_pdf(file_path)
        elif suffix in ['.txt', '.md']:
            with open(file_path, 'r', encoding='utf-8') as file:
                return file.read()
        else:
            logger.warning(f"Unsupported file type: {suffix} for file {file_path.name}")
            return ""
    except Exception as e:
        logger.error(f"Error reading file {file_path}: {e}")
        return ""

def load_knowledge_base():
    """Load all supported files from the kb folder into memory (recursively)."""
    global knowledge_base, kb_metadata, kb_images
    if not KB_FOLDER.exists():
        logger.warning(f"Knowledge base folder {KB_FOLDER} does not exist.")
        return 0
    
    knowledge_base = {}
    kb_metadata = {}
    kb_images = {}
    
    # Supported file types
    supported_extensions = ['*.pdf', '*.txt', '*.md']
    if NBFORMAT_AVAILABLE:
        supported_extensions.append('*.ipynb')
    files = []
    for ext in supported_extensions:
        # Use rglob() instead of glob() to search recursively in subdirectories
        files.extend(list(KB_FOLDER.rglob(ext)))
    
    logger.info(f"Found {len(files)} files in knowledge base folder (including subdirectories)")
    
    for file_path in files:
        # Get relative path from KB_FOLDER to preserve folder structure
        relative_path = file_path.relative_to(KB_FOLDER)
        relative_path_str = str(relative_path).replace('\\', '/')  # Normalize path separators
        
        logger.info(f"Loading knowledge base file: {relative_path_str}")
        # Use appropriate extraction method based on file type
        if file_path.suffix.lower() == '.ipynb' and NBFORMAT_AVAILABLE:
            text = read_ipynb_text(file_path)
        else:
            text = extract_text_from_file(file_path)
        if text.strip():
            # Use relative path as key instead of just filename
            knowledge_base[relative_path_str] = text
            kb_metadata[relative_path_str] = {
                'type': file_path.suffix.lower(),
                'size': len(text),
                'loaded_at': datetime.now().isoformat(),
                'folder': str(relative_path.parent) if relative_path.parent != Path('.') else 'root'
            }
            
            # Extract images from PDFs (with timeout protection)
            if file_path.suffix.lower() == '.pdf':
                try:
                    images = extract_images_from_pdf(file_path, relative_path_str)
                    if images:
                        kb_images[relative_path_str] = images
                        kb_metadata[relative_path_str]['images'] = len(images)
                        logger.info(f"Extracted {len(images)} images from {relative_path_str}")
                except Exception as e:
                    logger.warning(f"Error extracting images from {relative_path_str}: {e}. Continuing without images.")
                    # Continue loading the PDF text even if image extraction fails
            
            # For markdown files, find associated PNG images in the same folder
            if file_path.suffix.lower() == '.md':
                try:
                    # Get the folder containing this markdown file
                    md_folder = file_path.parent
                    # Find all PNG images in the same folder
                    png_files = list(md_folder.glob('*.png'))
                    if png_files:
                        # Store relative paths to images
                        image_paths = []
                        for png_file in png_files:
                            # Get relative path from KB_FOLDER
                            png_relative = png_file.relative_to(KB_FOLDER)
                            png_relative_str = str(png_relative).replace('\\', '/')
                            image_paths.append(png_relative_str)
                        kb_images[relative_path_str] = image_paths
                        kb_metadata[relative_path_str]['images'] = len(image_paths)
                        logger.info(f"Found {len(image_paths)} PNG images for {relative_path_str}")
                except Exception as e:
                    logger.warning(f"Error finding images for {relative_path_str}: {e}")
    
    logger.info(f"Loaded {len(knowledge_base)} documents into knowledge base.")
    return len(knowledge_base)

def load_persona_data():
    """Load all supported files from the me folder into memory.
    
    In production, this will fail-fast if required persona files are missing.
    """
    global persona_data, persona_metadata
    
    # Check if we're in production (Cloud Run sets PORT env var, or check for production indicators)
    is_production = os.getenv("PORT") is not None or os.getenv("ENVIRONMENT") == "production"
    
    if not ME_FOLDER.exists():
        error_msg = f"CRITICAL: Persona folder {ME_FOLDER} does not exist. Absolute path: {ME_FOLDER.resolve()}"
        logger.error(error_msg)
        if is_production:
            logger.critical("PRODUCTION ERROR: Persona folder missing. Crashing to prevent silent failure.")
            raise FileNotFoundError(error_msg)
        logger.warning(error_msg)
        return 0
    
    persona_data = {}
    persona_metadata = {}
    
    # Supported file types for persona data
    supported_extensions = ['*.pdf', '*.txt', '*.md']
    files = []
    for ext in supported_extensions:
        files.extend(list(ME_FOLDER.rglob(ext)))  # Use rglob for recursive search (Fix E)
    
    logger.info(f"Found {len(files)} files in persona folder")
    
    # In production, require summary.txt (critical for personal questions)
    if is_production:
        summary_file = ME_FOLDER / "summary.txt"
        if not summary_file.exists():
            error_msg = f"CRITICAL: Required persona file 'summary.txt' not found in {ME_FOLDER}. Absolute path: {summary_file.resolve()}"
            logger.critical(error_msg)
            raise FileNotFoundError(error_msg)
    
    for file_path in files:
        logger.info(f"Loading persona file: {file_path.name}")
        text = extract_text_from_file(file_path)
        if text.strip():
            persona_data[file_path.name] = text
            persona_metadata[file_path.name] = {
                'type': file_path.suffix.lower(),
                'size': len(text),
                'loaded_at': datetime.now().isoformat()
            }
    
    logger.info(f"Loaded {len(persona_data)} persona documents.")
    return len(persona_data)

def cleanup_old_sessions():
    """Clean up chat sessions older than 1 hour."""
    with session_lock:
        cutoff = datetime.now() - timedelta(hours=1)
        expired = [sid for sid, ts in session_timestamps.items() if ts < cutoff]
        for sid in expired:
            chat_sessions.pop(sid, None)
            session_timestamps.pop(sid, None)
            logger.info(f"Cleaned up expired session: {sid}")
        if expired:
            logger.info(f"Cleaned up {len(expired)} expired session(s)")

def extract_critical_facts(summary_text: str) -> Dict[str, str]:
    """Extract critical personal facts from summary text for embedding in base prompt.
    
    Returns a dictionary with extracted facts or empty dict if not found.
    """
    facts = {}
    if not summary_text:
        return facts
    
    # Extract birth date - look for "Born in December 1984" pattern
    birth_match = re.search(r'born in (december|january|february|march|april|may|june|july|august|september|october|november)\s+(\d{4})', summary_text, re.IGNORECASE)
    if birth_match:
        month = birth_match.group(1).capitalize()
        year = birth_match.group(2)
        facts['birth_date'] = f"{month} {year}"
        facts['birth_year'] = year
    
    # Extract university start year - look for "joined the Math school...in 2002"
    uni_start_match = re.search(r'joined.*?math.*?school.*?in\s+(\d{4})', summary_text, re.IGNORECASE)
    if uni_start_match:
        facts['university_start'] = uni_start_match.group(1)
    
    # Extract bachelor completion year - look for "completed my BSc...in 2014"
    bachelor_match = re.search(r'completed.*?bsc.*?in\s+(\d{4})', summary_text, re.IGNORECASE)
    if bachelor_match:
        facts['bachelor_year'] = bachelor_match.group(1)
    
    return facts

def build_system_prompt(include_hello_greeting: bool = True) -> str:
    """Build system prompt from base prompt and persona data from me folder.
    
    Args:
        include_hello_greeting: Whether to include the "Hello there" greeting rule
    """
    # Extract critical facts from summary.txt if available
    critical_facts = {}
    if persona_data and "summary.txt" in persona_data:
        critical_facts = extract_critical_facts(persona_data["summary.txt"])
    
    # Build the "About you" section with embedded critical facts
    about_you = """About you:
- Working as AI Operations | RLHF & Model Optimization at TaskUs (Jun 2024 - Ongoing)
- COMPLETED MSc in Data Science & Machine Learning from Hellenic Open University in 2025 (grade 9.98/10) - NOT pursuing, COMPLETED
- COMPLETED BSc in Mathematics from University of Ioannina in 2014
- Based in Thessaloniki, Greece

CRITICAL: When asked about education, ALWAYS state that the MSc was COMPLETED in 2025, NOT pursuing. Never say "pursuing", "currently studying", or "expected to complete". The MSc is COMPLETED."""
    
    # Add critical facts directly if extracted
    if critical_facts:
        facts_lines = []
        if 'birth_date' in critical_facts:
            facts_lines.append(f"- Birth date: {critical_facts['birth_date']}")
        # REMOVED: university_start - only mention when asked about education timeline
        # Keep it in summary.txt for education questions, but don't include in always-shown critical facts
        # if 'university_start' in critical_facts:
        #     facts_lines.append(f"- Started university: {critical_facts['university_start']} (Math school, University of Ioannina)")
        if 'bachelor_year' in critical_facts:
            facts_lines.append(f"- Completed BSc: {critical_facts['bachelor_year']}")
        
        if facts_lines:
            about_you += "\n\n🎯 CRITICAL PERSONAL FACTS (ALWAYS USE THESE - DO NOT REFUSE OR DECLINE):"
            about_you += "\n" + "\n".join(facts_lines)
            about_you += "\n\n⚠️ MANDATORY: When asked about birth date or age, you MUST use the birth date fact above. Only mention education timeline (university start, bachelor completion) when specifically asked about education background or timeline. This information is PUBLIC. Never say 'I don't share', 'That's private', 'I appreciate your curiosity but', or 'isn't something I have shared' - ALWAYS provide the information directly when asked. These are public biographical facts that you MUST answer when asked."
    
    base_prompt = f"""You ARE Panagiotis Paltsokas (Panos), a Data Scientist / AI Trust & Safety professional. You respond in FIRST PERSON as Panos himself, not as an AI assistant. Never mention that you are an AI, a chatbot, or a virtual assistant. You are Panos.

{about_you}

⚠️ CRITICAL: Personal timeline information is also provided in the Summary section below for additional context. ALWAYS use the critical facts above when answering questions about these topics. Do NOT make up dates or infer information that isn't explicitly provided.

