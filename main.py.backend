# FAISS Vector Search (Semantic Search)
# =============================================================
FAISS_DIR = Path("models/faiss")
FAISS_DIR.mkdir(parents=True, exist_ok=True)
FAISS_INDEX = FAISS_DIR / "index.faiss"
FAISS_STORE = FAISS_DIR / "store.jsonl"
EMBEDDINGS_MODEL = os.getenv("EMBEDDINGS_MODEL", "text-embedding-3-small")

# Embedding model hard limit is 8192 tokens per input
EMBED_MAX_TOKENS = int(os.getenv("EMBED_MAX_TOKENS", "8192"))
# Use a safety margin to avoid off-by-a-few tokenization differences
EMBED_TARGET_TOKENS = int(os.getenv("EMBED_TARGET_TOKENS", "7800"))

try:
    import tiktoken
    TIKTOKEN_AVAILABLE = True
except ImportError:
    TIKTOKEN_AVAILABLE = False
    logger.warning("tiktoken not available. Token counting will be estimated.")

def _get_embed_encoding():
    """Get the tokenizer encoding for the embedding model."""
    if not TIKTOKEN_AVAILABLE:
        return None
    # text-embedding-3-* uses cl100k_base
    return tiktoken.get_encoding("cl100k_base")

def count_tokens(text: str) -> int:
    """Count tokens in text using tiktoken (accurate) or estimate (fallback)."""
    if TIKTOKEN_AVAILABLE:
        enc = _get_embed_encoding()
        return len(enc.encode(text or ""))
    else:
        # Fallback: estimate ~4 chars per token
        return len(text or "") // 4

def split_text_by_tokens(text: str, max_tokens: int = EMBED_TARGET_TOKENS) -> List[str]:
    """
    Split text into chunks of <= max_tokens using the tokenizer (hard guarantee).
    Tries to split on paragraph/sentence boundaries near the end of each chunk.
    """
    if not text or not text.strip():
        return []
    
    if not TIKTOKEN_AVAILABLE:
        # Fallback: use character-based splitting
        max_chars = max_tokens * 4
        if len(text) <= max_chars:
            return [text] if text.strip() else []
        # Simple character-based split
        chunks = []
        for i in range(0, len(text), max_chars):
            chunk = text[i:i + max_chars]
            if chunk.strip():
                chunks.append(chunk.strip())
        return chunks
    
    enc = _get_embed_encoding()
    toks = enc.encode(text or "")
    if len(toks) <= max_tokens:
        return [text] if text.strip() else []

    chunks = []
    start = 0
    while start < len(toks):
        end = min(start + max_tokens, len(toks))
        chunk_text = enc.decode(toks[start:end])

        # Try to move end backward to a natural boundary within the last ~400 chars
        # (keeps semantics cleaner than raw token slicing)
        if end < len(toks):
            window = chunk_text[-400:]
            cut = None
            for sep in ["\n\n", "\n", ". ", "! ", "? ", "; "]:
                idx = window.rfind(sep)
                if idx != -1:
                    cut = len(chunk_text) - 400 + idx + len(sep)
                    break
            if cut and cut > 200:
                chunk_text = chunk_text[:cut].rstrip()
                # Recompute start position based on tokens actually used
                used = len(enc.encode(chunk_text))
                end = start + used

        chunk_text = chunk_text.strip()
        if chunk_text:
            chunks.append(chunk_text)

        start = end

    return chunks

