{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "cd services/frontend && npm run build"
  },
  "deploy": {
    "startCommand": "cd services/frontend && sh start-frontend.sh",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
