# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!

# Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=<API key here>

# Backend API URL (for frontend)
# Local development: http://localhost:8000
# Production: <URL here>
VITE_API_URL=<URL here>

# Local PostgreSQL chat logging
POSTGRES_ENABLED=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=local_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_SSLMODE=disable

# Production Cloud SQL option for the backend
# If CLOUD_SQL_CONNECTION_NAME is set on Cloud Run, the backend will connect
# through the mounted unix socket /cloudsql/<instance-connection-name>.
# Example: my-gcp-project:europe-west8:virtual-persona-db
# CLOUD_SQL_CONNECTION_NAME=<instance-connection-name>

# Optional alternative: full PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@host:5432/local_db?sslmode=require

# Optional: Pushover notifications (for backend alerts)
# PUSHOVER_TOKEN=your_pushover_token_here
# PUSHOVER_USER=your_pushover_user_here
